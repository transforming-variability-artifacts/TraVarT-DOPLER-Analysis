<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <groupId>edu.kit.dopler</groupId>
  <artifactId>smt_dopler</artifactId>
  <version>2.0.0</version>
  <build>
    <extensions>
      <extension>
        <groupId>kr.motd.maven</groupId>
        <artifactId>os-maven-plugin</artifactId>
        <version>1.7.1</version>
      </extension>
    </extensions>
    <resources>
      <resource>
        <directory>src/main/resources</directory>
      </resource>
      <resource>
        <targetPath>${native.libs.dir}</targetPath>
        <directory>${native.libs.path}</directory>
      </resource>
    </resources>
    <plugins>
      <plugin>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.11.0</version>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>info.picocli</groupId>
              <artifactId>picocli-codegen</artifactId>
              <version>4.7.7</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.10.0</version>
        <executions>
          <execution>
            <id>fetch-host-natives</id>
            <phase>generate-resources</phase>
            <goals>
              <goal>copy</goal>
            </goals>
            <configuration>
              <outputDirectory>${native.libs.path}/${platform.dir}</outputDirectory>
              <overWriteReleases>false</overWriteReleases>
              <overWriteSnapshots>true</overWriteSnapshots>
              <overWriteIfNewer>true</overWriteIfNewer>
              <skip>${skipHostNatives}</skip>
              <artifactItems>
                <artifactItem>
                  <groupId>org.sosy-lab</groupId>
                  <artifactId>javasmt-solver-z3</artifactId>
                  <version>${z3.version}</version>
                  <classifier>libz3-${os.arch.suffix}</classifier>
                  <type>${os.extension}</type>
                  <destFileName>libz3.${os.extension}</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.sosy-lab</groupId>
                  <artifactId>javasmt-solver-z3</artifactId>
                  <version>${z3.version}</version>
                  <classifier>libz3java-${os.arch.suffix}</classifier>
                  <type>${os.extension}</type>
                  <destFileName>libz3java.${os.extension}</destFileName>
                </artifactItem>
                <artifactItem>
                  <groupId>org.sosy-lab</groupId>
                  <artifactId>javasmt-solver-cvc5</artifactId>
                  <version>${cvc5.version}</version>
                  <classifier>libcvc5jni-${os.arch.suffix}</classifier>
                  <type>${os.extension}</type>
                  <destFileName>libcvc5jni.${os.extension}</destFileName>
                </artifactItem>
              </artifactItems>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.5</version>
        <configuration>
          <argLine>-Djava.library.path=./dependencies --enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.codehaus.mojo</groupId>
        <artifactId>exec-maven-plugin</artifactId>
        <version>3.6.3</version>
        <configuration>
          <executable>java</executable>
          <arguments>
            <argument>-Djava.library.path=./dependencies</argument>
            <argument>--enable-native-access=ALL-UNNAMED</argument>
            <argument>-Dfile.encoding=UTF-8</argument>
            <argument>-classpath</argument>
            <classpath />
            <argument>edu.kit.dopler.Main</argument>
          </arguments>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-shade-plugin</artifactId>
        <version>3.6.2</version>
        <executions>
          <execution>
            <phase>package</phase>
            <goals>
              <goal>shade</goal>
            </goals>
            <configuration>
              <transformers>
                <transformer>
                  <mainClass>edu.kit.dopler.Main</mainClass>
                </transformer>
              </transformers>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <artifactId>maven-site-plugin</artifactId>
        <version>3.12.1</version>
      </plugin>
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>3.5.1</version>
        <executions>
          <execution>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <java>
            <palantirJavaFormat />
            <removeUnusedImports />
            <trimTrailingWhitespace />
            <endWithNewline />
            <licenseHeader>
              <file>${project.basedir}/license-header.txt</file>
            </licenseHeader>
          </java>
          <pom>
            <sortPom />
          </pom>
        </configuration>
      </plugin>
    </plugins>
  </build>
  <profiles>
    <profile>
      <id>os-linux</id>
      <properties>
        <os.family>linux</os.family>
        <os.extension>so</os.extension>
      </properties>
    </profile>
    <profile>
      <id>os-windows</id>
      <properties>
        <os.detected.arch>x86_64</os.detected.arch>
        <os.detected.bitness>64</os.detected.bitness>
        <os.detected.name>windows</os.detected.name>
        <os.family>windows</os.family>
        <os.extension>dll</os.extension>
        <os.detected.classifier>windows-x86_64</os.detected.classifier>
      </properties>
    </profile>
    <profile>
      <id>os-mac</id>
      <properties>
        <os.family>macos</os.family>
        <os.extension>dylib</os.extension>
      </properties>
    </profile>
    <profile>
      <id>arch-x64</id>
      <properties>
        <os.detected.arch>x86_64</os.detected.arch>
        <os.detected.bitness>64</os.detected.bitness>
        <os.detected.classifier>windows-x86_64</os.detected.classifier>
        <os.detected.name>windows</os.detected.name>
        <os.arch.suffix>x64</os.arch.suffix>
      </properties>
    </profile>
    <profile>
      <id>arch-x64-mac</id>
      <properties>
        <os.arch.suffix>x64</os.arch.suffix>
      </properties>
    </profile>
    <profile>
      <id>arch-arm64</id>
      <properties>
        <os.arch.suffix>arm64</os.arch.suffix>
      </properties>
    </profile>
    <profile>
      <id>enforce-platform-string</id>
      <properties>
        <os.detected.arch>x86_64</os.detected.arch>
        <os.detected.bitness>64</os.detected.bitness>
        <os.detected.name>windows</os.detected.name>
        <platform.dir>${os.family}-${os.arch.suffix}</platform.dir>
        <os.detected.classifier>windows-x86_64</os.detected.classifier>
        <skipHostNatives>false</skipHostNatives>
      </properties>
    </profile>
    <profile>
      <id>dist</id>
      <build>
        <plugins>
          <plugin>
            <artifactId>maven-dependency-plugin</artifactId>
            <executions>
              <execution>
                <id>fetch-all-dist-natives</id>
                <phase>generate-resources</phase>
                <goals>
                  <goal>copy</goal>
                </goals>
                <configuration>
                  <overWriteReleases>false</overWriteReleases>
                  <overWriteSnapshots>true</overWriteSnapshots>
                  <overWriteIfNewer>true</overWriteIfNewer>
                  <artifactItems>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3-x64</classifier>
                      <type>so</type>
                      <destFileName>libz3.so</destFileName>
                      <outputDirectory>${native.libs.path}/linux-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3java-x64</classifier>
                      <type>so</type>
                      <destFileName>libz3java.so</destFileName>
                      <outputDirectory>${native.libs.path}/linux-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-cvc5</artifactId>
                      <version>${cvc5.version}</version>
                      <classifier>libcvc5jni-x64</classifier>
                      <type>so</type>
                      <destFileName>libcvc5jni.so</destFileName>
                      <outputDirectory>${native.libs.path}/linux-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3-arm64</classifier>
                      <type>so</type>
                      <destFileName>libz3.so</destFileName>
                      <outputDirectory>${native.libs.path}/linux-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3java-arm64</classifier>
                      <type>so</type>
                      <destFileName>libz3java.so</destFileName>
                      <outputDirectory>${native.libs.path}/linux-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-cvc5</artifactId>
                      <version>${cvc5.version}</version>
                      <classifier>libcvc5jni-arm64</classifier>
                      <type>so</type>
                      <destFileName>libcvc5jni.so</destFileName>
                      <outputDirectory>${native.libs.path}/linux-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3-x64</classifier>
                      <type>dll</type>
                      <destFileName>libz3.dll</destFileName>
                      <outputDirectory>${native.libs.path}/windows-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3java-x64</classifier>
                      <type>dll</type>
                      <destFileName>libz3java.dll</destFileName>
                      <outputDirectory>${native.libs.path}/windows-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-cvc5</artifactId>
                      <version>${cvc5.version}</version>
                      <classifier>libcvc5jni-x64</classifier>
                      <type>dll</type>
                      <destFileName>libcvc5jni.dll</destFileName>
                      <outputDirectory>${native.libs.path}/windows-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3-arm64</classifier>
                      <type>dll</type>
                      <destFileName>libz3.dll</destFileName>
                      <outputDirectory>${native.libs.path}/windows-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3java-arm64</classifier>
                      <type>dll</type>
                      <destFileName>libz3java.dll</destFileName>
                      <outputDirectory>${native.libs.path}/windows-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-cvc5</artifactId>
                      <version>${cvc5.version}</version>
                      <classifier>libcvc5jni-arm64</classifier>
                      <type>dll</type>
                      <destFileName>libcvc5jni.dll</destFileName>
                      <outputDirectory>${native.libs.path}/windows-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3-x64</classifier>
                      <type>dylib</type>
                      <destFileName>libz3.dylib</destFileName>
                      <outputDirectory>${native.libs.path}/macos-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3java-x64</classifier>
                      <type>dylib</type>
                      <destFileName>libz3java.dylib</destFileName>
                      <outputDirectory>${native.libs.path}/macos-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-cvc5</artifactId>
                      <version>${cvc5.version}</version>
                      <classifier>libcvc5jni-x64</classifier>
                      <type>dylib</type>
                      <destFileName>libcvc5jni.dylib</destFileName>
                      <outputDirectory>${native.libs.path}/macos-x64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3-arm64</classifier>
                      <type>dylib</type>
                      <destFileName>libz3.dylib</destFileName>
                      <outputDirectory>${native.libs.path}/macos-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-z3</artifactId>
                      <version>${z3.version}</version>
                      <classifier>libz3java-arm64</classifier>
                      <type>dylib</type>
                      <destFileName>libz3java.dylib</destFileName>
                      <outputDirectory>${native.libs.path}/macos-arm64</outputDirectory>
                    </artifactItem>
                    <artifactItem>
                      <groupId>org.sosy-lab</groupId>
                      <artifactId>javasmt-solver-cvc5</artifactId>
                      <version>${cvc5.version}</version>
                      <classifier>libcvc5jni-arm64</classifier>
                      <type>dylib</type>
                      <destFileName>libcvc5jni.dylib</destFileName>
                      <outputDirectory>${native.libs.path}/macos-arm64</outputDirectory>
                    </artifactItem>
                  </artifactItems>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
      <properties>
        <os.detected.arch>x86_64</os.detected.arch>
        <os.detected.bitness>64</os.detected.bitness>
        <os.detected.classifier>windows-x86_64</os.detected.classifier>
        <os.detected.name>windows</os.detected.name>
        <skipHostNatives>true</skipHostNatives>
      </properties>
    </profile>
  </profiles>
  <dependencies>
    <dependency>
      <groupId>io.github.universal-variability-language</groupId>
      <artifactId>uvl-parser</artifactId>
      <version>0.3</version>
      <scope>provided</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>hamcrest-core</artifactId>
          <groupId>org.hamcrest</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-platform-engine</artifactId>
          <groupId>org.junit.platform</groupId>
        </exclusion>
        <exclusion>
          <artifactId>apiguardian-api</artifactId>
          <groupId>org.apiguardian</groupId>
        </exclusion>
      </exclusions>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>5.13.4</version>
      <scope>test</scope>
      <exclusions>
        <exclusion>
          <artifactId>junit-jupiter-api</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-params</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
        <exclusion>
          <artifactId>junit-jupiter-engine</artifactId>
          <groupId>org.junit.jupiter</groupId>
        </exclusion>
      </exclusions>
    </dependency>
  </dependencies>
  <reporting>
    <plugins>
      <plugin>
        <artifactId>maven-project-info-reports-plugin</artifactId>
        <version>3.5.0</version>
        <reportSets>
          <reportSet>
            <configuration>
              <skip>true</skip>
            </configuration>
          </reportSet>
        </reportSets>
      </plugin>
      <plugin>
        <artifactId>maven-surefire-report-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <testFailureIgnore>true</testFailureIgnore>
        </configuration>
      </plugin>
      <plugin>
        <artifactId>maven-checkstyle-plugin</artifactId>
        <version>${checkstyle-maven-plugin.version}</version>
        <configuration>
          <configLocation>${project.basedir}/checkstyle.xml</configLocation>
          <failsOnError>false</failsOnError>
        </configuration>
        <reportSets>
          <reportSet>
            <reports>
              <report>checkstyle</report>
            </reports>
          </reportSet>
        </reportSets>
      </plugin>
    </plugins>
  </reporting>
  <properties>
    <javadoc.disabled>true</javadoc.disabled>
    <javasmt.version>6.0.0</javasmt.version>
    <java.version>21</java.version>
    <maven.compiler.source>21</maven.compiler.source>
    <checkstyle-maven-plugin.version>3.6.0</checkstyle-maven-plugin.version>
    <native.libs.dir>dependencies</native.libs.dir>
    <z3.version>4.16.0</z3.version>
    <deploy.disabled>true</deploy.disabled>
    <maven.compiler.target>21</maven.compiler.target>
    <cvc5.version>2026-04-08-ca862b4</cvc5.version>
    <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    <source.disabled>true</source.disabled>
    <native.libs.path>${project.basedir}/${native.libs.dir}</native.libs.path>
  </properties>
</project>
